{
  "name": "teldrive-ui",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "generate:api": "openapi-typescript ../openapi/teldrive.openapi.yaml -o ./src/api/schema.ts",
    "lint": "biome lint --write --unsafe src",
    "format": "biome format --write src",
    "typecheck": "tsgo",
    "test": "playwright test e2e/file-manager.spec.ts e2e/viewers.spec.ts e2e/source-audit.spec.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@heroui/react": "^3.2.2",
    "@heroui/styles": "^3.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@vplayer/react": "^0.2.2",
    "foliate-js": "github:johnfactotum/foliate-js#399248a67a8862ffb5e6463a33f9d52b317ca2eb",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "pdfjs-dist": "^6.2.108",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-aria-components": "^1.19.0",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "tw-animate-css": "^1.4.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "overrides": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@iconify-json/gravity-ui": "^1.2.13",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/icon-park-outline": "^1.2.4",
    "@iconify-json/ion": "^1.2.7",
    "@iconify-json/material-symbols": "^1.2.86",
    "@playwright/test": "^1.61.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tanstack/router-plugin": "^1.168.23",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "fflate": "^0.8.3",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.1.5"
  }
}
