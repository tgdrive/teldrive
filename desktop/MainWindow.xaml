<Window x:Class="Teldrive.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="Teldrive Desktop v2" ThemeMode="Light" Width="1250" Height="850" MinWidth="800" MinHeight="600" WindowStartupLocation="CenterScreen" Background="#F6F8FC" FontFamily="Segoe UI" FontSize="14">
  <Grid><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
    <Border BorderBrush="#DFE5F0" BorderThickness="0,0,0,1" Padding="20,0"><DockPanel VerticalAlignment="Center"><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><TextBlock Text="☁" FontSize="30" Foreground="#1A73E8" Margin="0,0,12,0"/><StackPanel><TextBlock Text="Teldrive" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Desktop · v2" Foreground="#687489" FontSize="11"/></StackPanel></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="StartButton" Content="Iniciar" Click="StartClick" Margin="8,0"/><Button x:Name="StopButton" Content="Detener" Click="StopClick" Margin="8,0" IsEnabled="False"/><Button Content="Configuración" Click="SetupClick" Margin="8,0"/><Button Content="Actividad" Click="LogsClick" Margin="8,0"/></StackPanel></DockPanel></Border>
    <Grid Grid.Row="1">
      <wv:WebView2 x:Name="Browser" Visibility="Collapsed"/>
      <ScrollViewer x:Name="SetupView" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="780" Margin="32">
        <TextBlock Text="Tu unidad, en tu equipo" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Text="Configura el servidor local y abre tu cuenta de Telegram desde esta ventana. Teldrive, rclone, PostgreSQL y multimedia están integrados." Foreground="#687489" Margin="0,0,0,24"/>
        <Border Background="White" CornerRadius="16" Padding="24" Margin="0,0,0,20"><StackPanel>
          <TextBlock Text="Primer inicio" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <TextBlock Text="Base de datos" FontWeight="SemiBold"/><CheckBox x:Name="LocalDatabase" Content="Usar PostgreSQL integrado en este equipo" IsChecked="True" Margin="0,12,0,12" MinHeight="44"/><TextBlock Text="URL de PostgreSQL externo (opcional)"/><TextBox x:Name="DatabaseUrl" ToolTip="postgres://usuario:contraseña@servidor/base"/>
          <TextBlock Text="Puerto local de la UI"/><TextBox x:Name="HttpPort" Text="8080"/>
          <TextBlock Text="Usuario permitido de Telegram"/><TextBox x:Name="AllowedUser" ToolTip="Tu nombre de usuario de Telegram, sin @"/>
          <TextBlock Text="Puedes iniciar sesión con el código QR o tu número de teléfono. Limitar el usuario evita que otras cuentas se registren en este servidor." Foreground="#687489" Margin="0,0,0,16"/>
          <WrapPanel><Button Content="Guardar y abrir mi unidad" Click="ConfigureClick" Background="#1A73E8" Foreground="White"/><Button Content="Volver a mi unidad" Click="DriveClick"/></WrapPanel>
        </StackPanel></Border>
        <Border Background="White" CornerRadius="16" Padding="24" Margin="0,0,0,20"><StackPanel><TextBlock Text="Integraciones de Windows" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="Rclone compatible con v2 y FFmpeg están incluidos. WinFsp permite montar Teldrive como una unidad; su controlador se prepara con este botón." Foreground="#687489" Margin="0,0,0,16"/><WrapPanel><Button Content="Preparar WinFsp" Click="WinFspClick"/><Button Content="Preparar componentes de Microsoft" Click="RuntimeClick"/><Button Content="Abrir ajustes de rclone" Click="RcloneClick"/><Button Content="Carpeta de datos" Click="DataClick"/></WrapPanel></StackPanel></Border>
        <Border Background="White" CornerRadius="16" Padding="24"><StackPanel><TextBlock Text="Configuración avanzada" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="Edita el TOML completo de v2. La configuración se valida antes de guardarla y se aplica al reiniciar el servidor." Foreground="#687489"/><TextBox x:Name="ConfigEditor" AcceptsReturn="True" AcceptsTab="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" Height="250" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/><WrapPanel><Button Content="Guardar configuración avanzada" Click="SaveConfigClick"/><Button Content="Validar configuración" Click="ValidateClick"/></WrapPanel></StackPanel></Border>
      </StackPanel></ScrollViewer>
      <Grid x:Name="LogsView" Visibility="Collapsed" Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,16"><TextBlock Text="Actividad de los servicios" FontSize="24" FontWeight="SemiBold"/><Button Content="Volver" Click="DriveClick" HorizontalAlignment="Right"/></DockPanel><TextBox x:Name="Logs" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Background="#101923" Foreground="#DAE5F5"/></Grid>
    </Grid>
    <Border Grid.Row="2" Background="#EAF0FA" Padding="20,6"><TextBlock x:Name="Status" Text="Preparando componentes…" FontSize="12"/></Border>
  </Grid>
</Window>
