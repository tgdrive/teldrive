<UserControl x:Class="Teldrive.Desktop.RcloneAdvancedView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F6F8FC" UseLayoutRounding="True">
  <UserControl.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="16,8"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="MinHeight" Value="40"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,5,12,5"/><Setter Property="MinHeight" Value="32"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="36"/><Setter Property="Margin" Value="0,4,12,12"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="TabItem"><Setter Property="Padding" Value="18,12"/></Style>
    <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="RowHeight" Value="40"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="BorderBrush" Value="#E1E6F0"/></Style>
  </UserControl.Resources>
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Opciones adicionales de rclone" FontSize="26" FontWeight="SemiBold"/>
    <TextBlock x:Name="Summary" Grid.Row="1" Margin="0,6,0,16" Foreground="#687489"/>
    <TabControl x:Name="AdditionalTabs" Grid.Row="2" Background="White">
      <TabItem Header="Tareas"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="160"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DataGrid x:Name="TasksGrid" MouseDoubleClick="EditTaskClick"><DataGrid.Columns><DataGridTextColumn Header="Tarea" Binding="{Binding Name}" Width="180"/><DataGridTextColumn Header="Operación" Binding="{Binding OperationDisplay}" Width="100"/><DataGridTextColumn Header="Origen" Binding="{Binding Source}" Width="*" MinWidth="160"/><DataGridTextColumn Header="Destino" Binding="{Binding Destination}" Width="*" MinWidth="160"/></DataGrid.Columns></DataGrid>
        <WrapPanel Grid.Row="1" Margin="0,10,0,0"><Button Content="Nueva" Click="NewTaskClick"/><Button Content="Editar" Click="EditTaskClick"/><Button Content="Duplicar" Click="DuplicateTaskClick"/><Button Content="Eliminar" Click="DeleteTaskClick"/><Button Content="Añadir a la cola" Click="RunTaskClick"/><Button Content="Simular" Click="DryRunTaskClick"/><Button Content="Importar tareas" Click="ImportTasksClick"/><Button Content="Exportar tareas" Click="ExportTasksClick"/></WrapPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock x:Name="EditorTitle" Text="Nueva tarea" FontWeight="SemiBold" FontSize="18" Margin="0,8,0,8"/>
          <TextBlock Text="Nombre"/><TextBox x:Name="TaskName"/>
          <WrapPanel><StackPanel Width="210"><TextBlock Text="Dirección"/><ComboBox x:Name="Direction"><ComboBoxItem Content="Subir a Teldrive" Tag="upload" IsSelected="True"/><ComboBoxItem Content="Descargar a este equipo" Tag="download"/></ComboBox></StackPanel><StackPanel Width="210"><TextBlock Text="Operación"/><ComboBox x:Name="Operation"><ComboBoxItem Content="Copiar" Tag="copy" IsSelected="True"/><ComboBoxItem Content="Mover (elimina del origen)" Tag="move"/><ComboBoxItem Content="Sincronizar (replica y elimina)" Tag="sync"/><ComboBoxItem Content="Verificar contenido" Tag="check"/></ComboBox></StackPanel></WrapPanel>
          <TextBlock Text="Origen · ruta local absoluta o ruta en Teldrive, según dirección"/><TextBox x:Name="Source"/>
          <TextBlock Text="Destino · carpeta de Teldrive o carpeta local, según dirección"/><TextBox x:Name="Destination" Text="/"/>
          <WrapPanel><Button Content="Elegir carpeta local" Click="ChooseFolderClick"/><Button Content="Elegir archivo local" Click="ChooseFileClick"/></WrapPanel>
          <TextBlock Text="La copia de carpetas transfiere su contenido. Para conservar el nombre de la carpeta, inclúyelo en el destino." Foreground="#687489" Margin="0,0,0,12"/>
          <Expander Header="Opciones de transferencia" IsExpanded="True" Margin="0,0,0,12"><StackPanel Margin="0,12,0,0">
            <WrapPanel><StackPanel Width="140"><TextBlock Text="Transferencias"/><TextBox x:Name="Transfers" Text="4" Margin="0,4,12,12"/></StackPanel><StackPanel Width="140"><TextBlock Text="Verificadores"/><TextBox x:Name="Checkers" Text="8" Margin="0,4,12,12"/></StackPanel><StackPanel Width="140"><TextBlock Text="Reintentos"/><TextBox x:Name="Retries" Text="3" Margin="0,4,12,12"/></StackPanel><StackPanel Width="160"><TextBlock Text="Reintentos internos"/><TextBox x:Name="LowRetries" Text="10" Margin="0,4,12,12"/></StackPanel></WrapPanel>
            <WrapPanel><StackPanel Width="200"><TextBlock Text="Límite de velocidad (10M, 500K)"/><TextBox x:Name="Bandwidth" Margin="0,4,12,12"/></StackPanel><StackPanel Width="180"><TextBlock Text="Conexión: espera (segundos)"/><TextBox x:Name="ConnectTimeout" Text="60" Margin="0,4,12,12"/></StackPanel><StackPanel Width="180"><TextBlock Text="Inactividad (segundos)"/><TextBox x:Name="IdleTimeout" Text="300" Margin="0,4,12,12"/></StackPanel><StackPanel Width="180"><TextBlock Text="Profundidad (-1: sin límite)"/><TextBox x:Name="MaxDepth" Text="-1" Margin="0,4,12,12"/></StackPanel></WrapPanel>
            <WrapPanel><StackPanel Width="200"><TextBlock Text="Comparar por"/><ComboBox x:Name="Compare"><ComboBoxItem Content="Tamaño y modificación" Tag="default" IsSelected="True"/><ComboBoxItem Content="Tamaño y suma de comprobación" Tag="checksum"/><ComboBoxItem Content="Solo suma de comprobación" Tag="checksum-only"/><ComboBoxItem Content="Solo tamaño" Tag="size"/><ComboBoxItem Content="Solo modificación" Tag="modtime"/></ComboBox></StackPanel><StackPanel Width="220"><TextBlock Text="Eliminar al sincronizar"/><ComboBox x:Name="DeleteMode"><ComboBoxItem Content="Después de transferir" Tag="after" IsSelected="True"/><ComboBoxItem Content="Durante la transferencia" Tag="during"/><ComboBoxItem Content="Antes de transferir" Tag="before"/></ComboBox></StackPanel></WrapPanel>
            <WrapPanel><CheckBox x:Name="Immutable" Content="No sobrescribir archivos diferentes" IsChecked="True"/><CheckBox x:Name="SkipExisting" Content="Omitir archivos existentes"/><CheckBox x:Name="SkipNewer" Content="Omitir archivos más nuevos en destino"/><CheckBox x:Name="OneFileSystem" Content="No cruzar sistemas de archivos"/><CheckBox x:Name="NoModTime" Content="No actualizar fecha de archivos idénticos"/><CheckBox x:Name="DeleteExcluded" Content="Eliminar excluidos del destino (sync)"/></WrapPanel>
            <CheckBox x:Name="AllowDestructive" Content="Autorizo que esta tarea elimine archivos al mover, sincronizar o eliminar excluidos" Foreground="#A33F13"/>
          </StackPanel></Expander>
          <Expander Header="Filtros de archivos" Margin="0,0,0,12"><StackPanel Margin="0,12,0,0"><WrapPanel><StackPanel Width="180"><TextBlock Text="Tamaño mínimo (ej. 1M)"/><TextBox x:Name="MinSize" Margin="0,4,12,12"/></StackPanel><StackPanel Width="180"><TextBlock Text="Tamaño máximo (ej. 2G)"/><TextBox x:Name="MaxSize" Margin="0,4,12,12"/></StackPanel><StackPanel Width="180"><TextBlock Text="Antigüedad mínima (24h)"/><TextBox x:Name="MinAge" Margin="0,4,12,12"/></StackPanel><StackPanel Width="180"><TextBlock Text="Antigüedad máxima (7d)"/><TextBox x:Name="MaxAge" Margin="0,4,12,12"/></StackPanel></WrapPanel><TextBlock Text="Incluir patrones · uno por línea (ej. *.mp4)"/><TextBox x:Name="Includes" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto"/><TextBlock Text="Excluir patrones · uno por línea (ej. /cache/**)"/><TextBox x:Name="Excludes" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto"/></StackPanel></Expander>
          <Button x:Name="SaveTaskButton" Content="Guardar tarea" Click="SaveTaskClick" HorizontalAlignment="Left" Background="#1A73E8" Foreground="White"/>
        </StackPanel></ScrollViewer>
      </Grid></TabItem>
      <TabItem Header="Cola"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="130"/></Grid.RowDefinitions>
        <WrapPanel><Button x:Name="PauseButton" Content="Pausar cola" Click="PauseClick"/><TextBlock Text="Tareas simultáneas" VerticalAlignment="Center" Margin="8,0"/><ComboBox x:Name="Parallel" Width="75" SelectionChanged="ParallelChanged"><ComboBoxItem Content="1" IsSelected="True"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/></ComboBox><Button Content="Aplicar" Click="ApplyQueueClick"/></WrapPanel>
        <TextBlock Grid.Row="1" Text="Pausar la cola detiene el inicio de nuevas tareas; las que están en curso continúan. La cola se conserva al cerrar el programa." Foreground="#687489" Margin="0,0,0,12"/>
        <DataGrid Grid.Row="2" x:Name="QueueGrid" SelectionChanged="QueueSelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Tarea" Binding="{Binding Name}" Width="*" MinWidth="220"/><DataGridTextColumn Header="Estado" Binding="{Binding StateDisplay}" Width="170"/><DataGridTextColumn Header="Añadida" Binding="{Binding CreatedDisplay}" Width="130"/></DataGrid.Columns></DataGrid>
        <WrapPanel Grid.Row="3" Margin="0,12,0,0"><Button Content="Subir prioridad" Click="MoveUpClick"/><Button Content="Bajar prioridad" Click="MoveDownClick"/><Button Content="Cancelar / detener" Click="CancelClick"/><Button Content="Reintentar" Click="RetryClick"/><Button Content="Quitar" Click="RemoveClick"/><Button Content="Limpiar historial" Click="ClearHistoryClick"/><Button Content="Guardar registro" Click="ExportLogClick"/></WrapPanel>
        <TextBox Grid.Row="4" x:Name="QueueLog" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Background="#101923" Foreground="#DAE5F5"/>
      </Grid></TabItem>
      <TabItem Header="Programador"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DataGrid x:Name="SchedulesGrid"><DataGrid.Columns><DataGridTextColumn Header="Tarea" Binding="{Binding Name}" Width="*" MinWidth="180"/><DataGridTextColumn Header="Frecuencia" Binding="{Binding RepeatDisplay}" Width="140"/><DataGridTextColumn Header="Próxima ejecución" Binding="{Binding NextDisplay}" Width="180"/><DataGridTextColumn Header="Último resultado" Binding="{Binding LastResult}" Width="*" MinWidth="180"/></DataGrid.Columns></DataGrid>
        <WrapPanel Grid.Row="1" Margin="0,12,0,0"><Button Content="Nuevo horario" Click="NewScheduleClick"/><Button Content="Editar" Click="EditScheduleClick"/><Button Content="Activar / desactivar" Click="ToggleScheduleClick"/><Button Content="Eliminar horario" Click="DeleteScheduleClick"/></WrapPanel>
        <ScrollViewer Grid.Row="2" MaxHeight="280" VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="Tarea guardada"/><ComboBox x:Name="ScheduleTask" DisplayMemberPath="Name" SelectedValuePath="Id"/>
          <WrapPanel><StackPanel Width="175"><TextBlock Text="Primera fecha (hora local)"/><DatePicker x:Name="ScheduleDate" Margin="0,4,12,12" MinHeight="36"/></StackPanel><StackPanel Width="100"><TextBlock Text="Hora (HH:mm)"/><TextBox x:Name="ScheduleTime" Text="09:00" Margin="0,4,12,12"/></StackPanel><StackPanel Width="160"><TextBlock Text="Repetir"/><ComboBox x:Name="Repeat"><ComboBoxItem Content="Una vez" Tag="once" IsSelected="True"/><ComboBoxItem Content="Cada día" Tag="daily"/><ComboBoxItem Content="Cada semana" Tag="weekly"/><ComboBoxItem Content="Por intervalo" Tag="interval"/></ComboBox></StackPanel><StackPanel Width="180"><TextBlock Text="Intervalo (minutos)"/><TextBox x:Name="Interval" Text="60" Margin="0,4,12,12"/></StackPanel></WrapPanel>
          <CheckBox x:Name="RunMissed" Content="Ejecutar una vez los horarios pendientes al volver a abrir el programa"/>
          <TextBlock Text="El programador funciona mientras Teldrive está abierto, incluso en la bandeja. Usa el inicio automático si quieres activarlo al entrar en Windows. Las ejecuciones de una misma tarea no se superponen." Foreground="#687489" Margin="0,0,0,12"/>
          <Button Content="Guardar horario" Click="SaveScheduleClick" HorizontalAlignment="Left" Background="#1A73E8" Foreground="White"/>
        </StackPanel></ScrollViewer>
      </Grid></TabItem>
      <TabItem Header="Preferencias"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24" MaxWidth="750" HorizontalAlignment="Left">
        <TextBlock Text="Bandeja del sistema" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,16"/>
        <CheckBox x:Name="AlwaysTray" Content="Mostrar siempre el icono en la bandeja"/>
        <CheckBox x:Name="MinimizeTray" Content="Minimizar a la bandeja del sistema"/>
        <CheckBox x:Name="CloseTray" Content="Cerrar la ventana hacia la bandeja (mantener servicios y tareas)"/>
        <CheckBox x:Name="StartTray" Content="Abrir Teldrive directamente en la bandeja"/>
        <CheckBox x:Name="StartWindows" Content="Iniciar automáticamente con Windows, en la bandeja"/>
        <CheckBox x:Name="NotifyFinished" Content="Notificar las transferencias finalizadas" IsChecked="True"/>
        <TextBlock Text="Haz clic en el icono para recuperar la ventana. Para cerrar el programa y detener sus servicios, elige «Salir y detener servicios» en el menú de la bandeja. Windows controla la visualización de notificaciones." Foreground="#687489" Margin="0,16,0,20"/>
        <WrapPanel><Button Content="Guardar preferencias" Click="SavePreferencesClick" Background="#1A73E8" Foreground="White"/><Button Content="Minimizar ahora a la bandeja" Click="HideClick"/><Button Content="Salir y detener servicios" Click="ExitClick"/></WrapPanel>
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <TextBlock x:Name="Feedback" Grid.Row="3" Margin="0,12,0,0" Foreground="#174EA6"/>
  </Grid>
</UserControl>
