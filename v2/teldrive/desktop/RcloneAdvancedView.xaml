<UserControl x:Class="Teldrive.Desktop.RcloneAdvancedView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:Teldrive.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F6F8FC" UseLayoutRounding="True">
  <UserControl.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="16,8"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="MinHeight" Value="40"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,5,12,5"/><Setter Property="MinHeight" Value="32"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="36"/><Setter Property="Margin" Value="0,4,12,12"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="TabItem"><Setter Property="Padding" Value="18,12"/></Style>
    <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="RowHeight" Value="40"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="BorderBrush" Value="#E1E6F0"/></Style>
  </UserControl.Resources>
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="{local:Localize Text=&#x27;Opciones adicionales de rclone&#x27;}" FontSize="26" FontWeight="SemiBold"/>
    <TextBlock x:Name="Summary" Grid.Row="1" Margin="0,6,0,16" Foreground="#687489"/>
    <TabControl x:Name="AdditionalTabs" Grid.Row="2" Background="White">
      <TabItem Header="{local:Localize Text=&#x27;Tareas&#x27;}"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="160"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DataGrid x:Name="TasksGrid" MouseDoubleClick="EditTaskClick"><DataGrid.Columns><DataGridTextColumn Header="{local:Localize Text=&#x27;Tarea&#x27;}" Binding="{Binding Name}" Width="180"/><DataGridTextColumn Header="{local:Localize Text=&#x27;Operación&#x27;}" Binding="{Binding OperationDisplay}" Width="130"/><DataGridTextColumn Header="{local:Localize Text=&#x27;Inicio&#x27;}" Binding="{Binding StartupDisplay}" Width="110"/><DataGridTextColumn Header="{local:Localize Text=&#x27;Origen&#x27;}" Binding="{Binding Source}" Width="*" MinWidth="160"/><DataGridTextColumn Header="{local:Localize Text=&#x27;Destino&#x27;}" Binding="{Binding Destination}" Width="*" MinWidth="160"/></DataGrid.Columns></DataGrid>
        <WrapPanel Grid.Row="1" Margin="0,10,0,0"><Button Content="{local:Localize Text=&#x27;Nueva&#x27;}" Click="NewTaskClick"/><Button Content="{local:Localize Text=&#x27;Editar&#x27;}" Click="EditTaskClick"/><Button Content="{local:Localize Text=&#x27;Duplicar&#x27;}" Click="DuplicateTaskClick"/><Button Content="{local:Localize Text=&#x27;Eliminar&#x27;}" Click="DeleteTaskClick"/><Button Content="{local:Localize Text=&#x27;Añadir a la cola&#x27;}" Click="RunTaskClick"/><Button Content="{local:Localize Text=&#x27;Simular&#x27;}" Click="DryRunTaskClick"/><Button Content="{local:Localize Text=&#x27;Importar tareas&#x27;}" Click="ImportTasksClick"/><Button Content="{local:Localize Text=&#x27;Exportar tareas&#x27;}" Click="ExportTasksClick"/></WrapPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock x:Name="EditorTitle" Text="{local:Localize Text=&#x27;Nueva tarea&#x27;}" FontWeight="SemiBold" FontSize="18" Margin="0,8,0,8"/>
          <TextBlock Text="{local:Localize Text=&#x27;Nombre&#x27;}"/><TextBox x:Name="TaskName"/>
          <WrapPanel><StackPanel Width="210"><TextBlock Text="{local:Localize Text=&#x27;Dirección&#x27;}"/><ComboBox x:Name="Direction"><ComboBoxItem Content="{local:Localize Text=&#x27;Subir a Teldrive&#x27;}" Tag="upload" IsSelected="True"/><ComboBoxItem Content="{local:Localize Text=&#x27;Descargar a este equipo&#x27;}" Tag="download"/></ComboBox></StackPanel><StackPanel Width="250"><TextBlock Text="{local:Localize Text=&#x27;Operación&#x27;}"/><ComboBox x:Name="Operation" SelectionChanged="OperationChanged"><ComboBoxItem Content="{local:Localize Text=&#x27;Copiar&#x27;}" Tag="copy" IsSelected="True"/><ComboBoxItem Content="{local:Localize Text=&#x27;Mover (elimina del origen)&#x27;}" Tag="move"/><ComboBoxItem Content="{local:Localize Text=&#x27;Sincronizar (replica y elimina)&#x27;}" Tag="sync"/><ComboBoxItem Content="{local:Localize Text=&#x27;Verificar contenido&#x27;}" Tag="check"/><ComboBoxItem Content="{local:Localize Text=&#x27;Montar unidad persistente&#x27;}" Tag="mount"/></ComboBox></StackPanel></WrapPanel>
          <TextBlock Text="Conexión de rclone.conf"/><TextBox x:Name="TaskRemote" Text="teldrive"/><TextBlock x:Name="SourceLabel" Text="{local:Localize Text=&#x27;Origen · ruta local absoluta o ruta en la conexión remota, según dirección&#x27;}"/><TextBox x:Name="Source"/>
          <TextBlock x:Name="DestinationLabel" Text="{local:Localize Text=&#x27;Destino · carpeta remota o carpeta local, según dirección&#x27;}"/><TextBox x:Name="Destination" Text="/"/>
          <WrapPanel x:Name="LocalPickers"><Button Content="{local:Localize Text=&#x27;Elegir carpeta local&#x27;}" Click="ChooseFolderClick"/><Button Content="{local:Localize Text=&#x27;Elegir archivo local&#x27;}" Click="ChooseFileClick"/></WrapPanel>
          <StackPanel x:Name="MountOptions" Visibility="Collapsed" Margin="0,0,0,16">
            <CheckBox x:Name="MountStartup" Content="{local:Localize Text=&#x27;Montar automáticamente al iniciar Teldrive Desktop&#x27;}"/>
            <CheckBox x:Name="MountReadOnly" Content="{local:Localize Text=&#x27;Montar como solo lectura&#x27;}"/>
            <WrapPanel><StackPanel Width="180"><TextBlock Text="{local:Localize Text=&#x27;Modo de caché&#x27;}"/><ComboBox x:Name="MountCacheMode"><ComboBoxItem Content="{local:Localize Text=&#x27;Completa&#x27;}" Tag="full" IsSelected="True"/><ComboBoxItem Content="{local:Localize Text=&#x27;Escrituras&#x27;}" Tag="writes"/><ComboBoxItem Content="{local:Localize Text=&#x27;Mínima&#x27;}" Tag="minimal"/><ComboBoxItem Content="{local:Localize Text=&#x27;Desactivada&#x27;}" Tag="off"/></ComboBox></StackPanel><StackPanel Width="180"><TextBlock Text="{local:Localize Text=&#x27;Límite de caché (10G)&#x27;}"/><TextBox x:Name="MountCacheSize" Text="10G" Margin="0,4,12,12"/></StackPanel><StackPanel Width="180"><TextBlock Text="{local:Localize Text=&#x27;Duración de caché (24h)&#x27;}"/><TextBox x:Name="MountCacheAge" Text="24h" Margin="0,4,12,12"/></StackPanel></WrapPanel>
            <TextBlock Text="{local:Localize Text=&#x27;Guarda la tarea y activa el inicio con Windows en Preferencias. La unidad se monta cuando el servidor y rclone están disponibles. Si rclone.conf está cifrado, espera a que lo desbloquees. Detén el montaje desde Cola para desmontar la unidad.&#x27;}" TextWrapping="Wrap" Foreground="#687489"/>
          </StackPanel>
          <TextBlock Text="{local:Localize Text=&#x27;La copia de carpetas transfiere su contenido. Para conservar el nombre de la carpeta, inclúyelo en el destino.&#x27;}" Foreground="#687489" Margin="0,0,0,12"/>
          <Expander x:Name="TransferOptions" Header="{local:Localize Text=&#x27;Opciones de transferencia&#x27;}" IsExpanded="True" Margin="0,0,0,12"><StackPanel Margin="0,12,0,0">
            <WrapPanel><StackPanel Width="140"><TextBlock Text="{local:Localize Text=&#x27;Transferencias&#x27;}"/><TextBox x:Name="Transfers" Text="4" Margin="0,4,12,12"/></StackPanel><StackPanel Width="140"><TextBlock Text="{local:Localize Text=&#x27;Verificadores&#x27;}"/><TextBox x:Name="Checkers" Text="8" Margin="0,4,12,12"/></StackPanel><StackPanel Width="140"><TextBlock Text="{local:Localize Text=&#x27;Reintentos&#x27;}"/><TextBox x:Name="Retries" Text="3" Margin="0,4,12,12"/></StackPanel><StackPanel Width="160"><TextBlock Text="{local:Localize Text=&#x27;Reintentos internos&#x27;}"/><TextBox x:Name="LowRetries" Text="10" Margin="0,4,12,12"/></StackPanel></WrapPanel>
            <WrapPanel><StackPanel Width="200"><TextBlock Text="{local:Localize Text=&#x27;Límite de velocidad (10M, 500K)&#x27;}"/><TextBox x:Name="Bandwidth" Margin="0,4,12,12"/></StackPanel><StackPanel Width="180"><TextBlock Text="{local:Localize Text=&#x27;Conexión: espera (segundos)&#x27;}"/><TextBox x:Name="ConnectTimeout" Text="60" Margin="0,4,12,12"/></StackPanel><StackPanel Width="180"><TextBlock Text="{local:Localize Text=&#x27;Inactividad (segundos)&#x27;}"/><TextBox x:Name="IdleTimeout" Text="300" Margin="0,4,12,12"/></StackPanel><StackPanel Width="180"><TextBlock Text="{local:Localize Text=&#x27;Profundidad (-1: sin límite)&#x27;}"/><TextBox x:Name="MaxDepth" Text="-1" Margin="0,4,12,12"/></StackPanel></WrapPanel>
            <WrapPanel><StackPanel Width="200"><TextBlock Text="{local:Localize Text=&#x27;Comparar por&#x27;}"/><ComboBox x:Name="Compare"><ComboBoxItem Content="{local:Localize Text=&#x27;Tamaño y modificación&#x27;}" Tag="default" IsSelected="True"/><ComboBoxItem Content="{local:Localize Text=&#x27;Tamaño y suma de comprobación&#x27;}" Tag="checksum"/><ComboBoxItem Content="{local:Localize Text=&#x27;Solo suma de comprobación&#x27;}" Tag="checksum-only"/><ComboBoxItem Content="{local:Localize Text=&#x27;Solo tamaño&#x27;}" Tag="size"/><ComboBoxItem Content="{local:Localize Text=&#x27;Solo modificación&#x27;}" Tag="modtime"/></ComboBox></StackPanel><StackPanel Width="220"><TextBlock Text="{local:Localize Text=&#x27;Eliminar al sincronizar&#x27;}"/><ComboBox x:Name="DeleteMode"><ComboBoxItem Content="{local:Localize Text=&#x27;Después de transferir&#x27;}" Tag="after" IsSelected="True"/><ComboBoxItem Content="{local:Localize Text=&#x27;Durante la transferencia&#x27;}" Tag="during"/><ComboBoxItem Content="{local:Localize Text=&#x27;Antes de transferir&#x27;}" Tag="before"/></ComboBox></StackPanel></WrapPanel>
            <WrapPanel><CheckBox x:Name="Immutable" Content="{local:Localize Text=&#x27;No sobrescribir archivos diferentes&#x27;}" IsChecked="True"/><CheckBox x:Name="SkipExisting" Content="{local:Localize Text=&#x27;Omitir archivos existentes&#x27;}"/><CheckBox x:Name="SkipNewer" Content="{local:Localize Text=&#x27;Omitir archivos más nuevos en destino&#x27;}"/><CheckBox x:Name="OneFileSystem" Content="{local:Localize Text=&#x27;No cruzar sistemas de archivos&#x27;}"/><CheckBox x:Name="NoModTime" Content="{local:Localize Text=&#x27;No actualizar fecha de archivos idénticos&#x27;}"/><CheckBox x:Name="DeleteExcluded" Content="{local:Localize Text=&#x27;Eliminar excluidos del destino (sync)&#x27;}"/></WrapPanel>
            <CheckBox x:Name="AllowDestructive" Content="{local:Localize Text=&#x27;Autorizo que esta tarea elimine archivos al mover, sincronizar o eliminar excluidos&#x27;}" Foreground="#A33F13"/>
          </StackPanel></Expander>
          <Expander x:Name="FilterOptions" Header="{local:Localize Text=&#x27;Filtros de archivos&#x27;}" Margin="0,0,0,12"><StackPanel Margin="0,12,0,0"><WrapPanel><StackPanel Width="180"><TextBlock Text="{local:Localize Text=&#x27;Tamaño mínimo (ej. 1M)&#x27;}"/><TextBox x:Name="MinSize" Margin="0,4,12,12"/></StackPanel><StackPanel Width="180"><TextBlock Text="{local:Localize Text=&#x27;Tamaño máximo (ej. 2G)&#x27;}"/><TextBox x:Name="MaxSize" Margin="0,4,12,12"/></StackPanel><StackPanel Width="180"><TextBlock Text="{local:Localize Text=&#x27;Antigüedad mínima (24h)&#x27;}"/><TextBox x:Name="MinAge" Margin="0,4,12,12"/></StackPanel><StackPanel Width="180"><TextBlock Text="{local:Localize Text=&#x27;Antigüedad máxima (7d)&#x27;}"/><TextBox x:Name="MaxAge" Margin="0,4,12,12"/></StackPanel></WrapPanel><TextBlock Text="{local:Localize Text=&#x27;Incluir patrones · uno por línea (ej. *.mp4)&#x27;}"/><TextBox x:Name="Includes" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto"/><TextBlock Text="{local:Localize Text=&#x27;Excluir patrones · uno por línea (ej. /cache/**)&#x27;}"/><TextBox x:Name="Excludes" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto"/></StackPanel></Expander>
          <Button x:Name="SaveTaskButton" Content="{local:Localize Text=&#x27;Guardar tarea&#x27;}" Click="SaveTaskClick" HorizontalAlignment="Left" Background="#1A73E8" Foreground="White"/>
        </StackPanel></ScrollViewer>
      </Grid></TabItem>
      <TabItem Header="{local:Localize Text=&#x27;Cola&#x27;}"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="130"/></Grid.RowDefinitions>
        <WrapPanel><Button x:Name="PauseButton" Content="{local:Localize Text=&#x27;Pausar cola&#x27;}" Click="PauseClick"/><TextBlock Text="{local:Localize Text=&#x27;Tareas simultáneas&#x27;}" VerticalAlignment="Center" Margin="8,0"/><ComboBox x:Name="Parallel" Width="75" SelectionChanged="ParallelChanged"><ComboBoxItem Content="1" IsSelected="True"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/></ComboBox><Button Content="{local:Localize Text=&#x27;Aplicar&#x27;}" Click="ApplyQueueClick"/></WrapPanel>
        <TextBlock Grid.Row="1" Text="{local:Localize Text=&#x27;Pausar la cola detiene el inicio de nuevas tareas; las que están en curso continúan. La cola se conserva al cerrar el programa.&#x27;}" Foreground="#687489" Margin="0,0,0,12"/>
        <DataGrid Grid.Row="2" x:Name="QueueGrid" SelectionChanged="QueueSelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="{local:Localize Text=&#x27;Tarea&#x27;}" Binding="{Binding Name}" Width="*" MinWidth="220"/><DataGridTextColumn Header="{local:Localize Text=&#x27;Estado&#x27;}" Binding="{Binding StateDisplay}" Width="170"/><DataGridTextColumn Header="{local:Localize Text=&#x27;Añadida&#x27;}" Binding="{Binding CreatedDisplay}" Width="130"/></DataGrid.Columns></DataGrid>
        <WrapPanel Grid.Row="3" Margin="0,12,0,0"><Button Content="{local:Localize Text=&#x27;Subir prioridad&#x27;}" Click="MoveUpClick"/><Button Content="{local:Localize Text=&#x27;Bajar prioridad&#x27;}" Click="MoveDownClick"/><Button Content="{local:Localize Text=&#x27;Cancelar / detener&#x27;}" Click="CancelClick"/><Button Content="{local:Localize Text=&#x27;Reintentar&#x27;}" Click="RetryClick"/><Button Content="{local:Localize Text=&#x27;Quitar&#x27;}" Click="RemoveClick"/><Button Content="{local:Localize Text=&#x27;Limpiar historial&#x27;}" Click="ClearHistoryClick"/><Button Content="{local:Localize Text=&#x27;Guardar registro&#x27;}" Click="ExportLogClick"/></WrapPanel>
        <TextBox Grid.Row="4" x:Name="QueueLog" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Background="#101923" Foreground="#DAE5F5"/>
      </Grid></TabItem>
      <TabItem Header="{local:Localize Text=&#x27;Programador&#x27;}"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DataGrid x:Name="SchedulesGrid"><DataGrid.Columns><DataGridTextColumn Header="{local:Localize Text=&#x27;Tarea&#x27;}" Binding="{Binding Name}" Width="*" MinWidth="180"/><DataGridTextColumn Header="{local:Localize Text=&#x27;Frecuencia&#x27;}" Binding="{Binding RepeatDisplay}" Width="140"/><DataGridTextColumn Header="{local:Localize Text=&#x27;Próxima ejecución&#x27;}" Binding="{Binding NextDisplay}" Width="180"/><DataGridTextColumn Header="{local:Localize Text=&#x27;Último resultado&#x27;}" Binding="{Binding LastResult}" Width="*" MinWidth="180"/></DataGrid.Columns></DataGrid>
        <WrapPanel Grid.Row="1" Margin="0,12,0,0"><Button Content="{local:Localize Text=&#x27;Nuevo horario&#x27;}" Click="NewScheduleClick"/><Button Content="{local:Localize Text=&#x27;Editar&#x27;}" Click="EditScheduleClick"/><Button Content="{local:Localize Text=&#x27;Activar / desactivar&#x27;}" Click="ToggleScheduleClick"/><Button Content="{local:Localize Text=&#x27;Eliminar horario&#x27;}" Click="DeleteScheduleClick"/></WrapPanel>
        <ScrollViewer Grid.Row="2" MaxHeight="280" VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="{local:Localize Text=&#x27;Tarea guardada&#x27;}"/><ComboBox x:Name="ScheduleTask" DisplayMemberPath="Name" SelectedValuePath="Id"/>
          <WrapPanel><StackPanel Width="175"><TextBlock Text="{local:Localize Text=&#x27;Primera fecha (hora local)&#x27;}"/><DatePicker x:Name="ScheduleDate" Margin="0,4,12,12" MinHeight="36"/></StackPanel><StackPanel Width="100"><TextBlock Text="{local:Localize Text=&#x27;Hora (HH:mm)&#x27;}"/><TextBox x:Name="ScheduleTime" Text="09:00" Margin="0,4,12,12"/></StackPanel><StackPanel Width="160"><TextBlock Text="{local:Localize Text=&#x27;Repetir&#x27;}"/><ComboBox x:Name="Repeat"><ComboBoxItem Content="{local:Localize Text=&#x27;Una vez&#x27;}" Tag="once" IsSelected="True"/><ComboBoxItem Content="{local:Localize Text=&#x27;Cada día&#x27;}" Tag="daily"/><ComboBoxItem Content="{local:Localize Text=&#x27;Cada semana&#x27;}" Tag="weekly"/><ComboBoxItem Content="{local:Localize Text=&#x27;Por intervalo&#x27;}" Tag="interval"/></ComboBox></StackPanel><StackPanel Width="180"><TextBlock Text="{local:Localize Text=&#x27;Intervalo (minutos)&#x27;}"/><TextBox x:Name="Interval" Text="60" Margin="0,4,12,12"/></StackPanel></WrapPanel>
          <CheckBox x:Name="RunMissed" Content="{local:Localize Text=&#x27;Ejecutar una vez los horarios pendientes al volver a abrir el programa&#x27;}"/>
          <TextBlock Text="{local:Localize Text=&#x27;El programador funciona mientras Teldrive está abierto, incluso en la bandeja. Usa el inicio automático si quieres activarlo al entrar en Windows. Las ejecuciones de una misma tarea no se superponen.&#x27;}" Foreground="#687489" Margin="0,0,0,12"/>
          <Button Content="{local:Localize Text=&#x27;Guardar horario&#x27;}" Click="SaveScheduleClick" HorizontalAlignment="Left" Background="#1A73E8" Foreground="White"/>
        </StackPanel></ScrollViewer>
      </Grid></TabItem>
      <TabItem Header="rclone.conf"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="{local:Localize Text=&#x27;Archivo de configuración personalizado&#x27;}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{local:Localize Text=&#x27;Importa una copia de tu rclone.conf y edita cualquiera de sus conexiones. Se conservan las opciones adicionales y se guarda un respaldo al aplicar cambios.&#x27;}" TextWrapping="Wrap" Margin="0,8,0,12"/><TextBlock x:Name="RcloneConfigPath" Foreground="#687489" TextWrapping="Wrap"/></StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,12,0,0"><Button Content="Seleccionar rclone.conf" Click="ImportConfigFileClick"/><Button Content="{local:Localize Text=&#x27;Cargar configuración actual&#x27;}" Click="LoadConfigFileClick"/><Button Content="{local:Localize Text=&#x27;Exportar copia&#x27;}" Click="ExportConfigFileClick"/><TextBlock Text="{local:Localize Text=&#x27;Contraseña&#x27;}" VerticalAlignment="Center" Margin="8,0"/><PasswordBox x:Name="ConfigPassword" Width="160" Margin="0,0,8,8"/><Button Content="{local:Localize Text=&#x27;Desbloquear&#x27;}" Click="UnlockConfigFileClick"/></WrapPanel>
        <StackPanel Grid.Row="2"><TextBlock Text="{local:Localize Text=&#x27;Conexión&#x27;}"/><ComboBox x:Name="ConfigRemote" SelectionChanged="ConfigRemoteChanged"/><TextBlock Text="{local:Localize Text=&#x27;Valores privados ocultos en la lista. Selecciona una opción para editarla.&#x27;}" Foreground="#687489" Margin="0,0,0,8"/></StackPanel>
        <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions><DataGrid x:Name="ConfigOptions" IsReadOnly="True" SelectionChanged="ConfigOptionChanged"><DataGrid.Columns><DataGridTextColumn Header="{local:Localize Text=&#x27;Opción&#x27;}" Binding="{Binding Key}" Width="*"/><DataGridTextColumn Header="{local:Localize Text=&#x27;Valor&#x27;}" Binding="{Binding DisplayValue}" Width="2*"/></DataGrid.Columns></DataGrid><StackPanel Grid.Column="1" Margin="16,0,0,0"><TextBlock Text="{local:Localize Text=&#x27;Nombre de opción&#x27;}"/><TextBox x:Name="ConfigOptionKey"/><TextBlock Text="{local:Localize Text=&#x27;Valor&#x27;}"/><TextBox x:Name="ConfigOptionValue"/><PasswordBox x:Name="ConfigOptionSecret" Visibility="Collapsed" MinHeight="36" Margin="0,4,0,12"/><WrapPanel><Button Content="{local:Localize Text=&#x27;Aplicar opción&#x27;}" Click="ApplyConfigOptionClick"/><Button Content="{local:Localize Text=&#x27;Quitar opción&#x27;}" Click="RemoveConfigOptionClick"/></WrapPanel><CheckBox x:Name="ShowRawConfig" Content="{local:Localize Text=&#x27;Editar el contenido completo&#x27;}" Checked="ShowRawConfigChanged" Unchecked="ShowRawConfigChanged"/><TextBox x:Name="RawConfigEditor" Visibility="Collapsed" AcceptsReturn="True" AcceptsTab="True" Height="180" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></StackPanel></Grid>
        <WrapPanel Grid.Row="4" Margin="0,16,0,0"><Button Content="Guardar rclone.conf" Click="SaveConfigFileClick" Background="#1A73E8" Foreground="White"/><TextBlock Text="{local:Localize Text=&#x27;Los cambios se aplican con las transferencias y los montajes detenidos.&#x27;}" VerticalAlignment="Center" Foreground="#687489"/></WrapPanel>
      </Grid></TabItem>
      <TabItem Header="{local:Localize Text=&#x27;Preferencias&#x27;}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24" MaxWidth="750" HorizontalAlignment="Left">
        <TextBlock Text="{local:Localize Text=&#x27;Idioma&#x27;}" FontSize="21" FontWeight="SemiBold"/>
        <ComboBox x:Name="LanguageChoice" DisplayMemberPath="Name" SelectedValuePath="Id" Width="240" HorizontalAlignment="Left"/>
        <TextBlock Text="{local:Localize Text=&#x27;Bandeja del sistema&#x27;}" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,16"/>
        <CheckBox x:Name="AlwaysTray" Content="{local:Localize Text=&#x27;Mostrar siempre el icono en la bandeja&#x27;}"/>
        <CheckBox x:Name="MinimizeTray" Content="{local:Localize Text=&#x27;Minimizar a la bandeja del sistema&#x27;}"/>
        <CheckBox x:Name="CloseTray" Content="{local:Localize Text=&#x27;Cerrar la ventana hacia la bandeja (mantener servicios y tareas)&#x27;}"/>
        <CheckBox x:Name="StartTray" Content="{local:Localize Text=&#x27;Abrir Teldrive directamente en la bandeja&#x27;}"/>
        <CheckBox x:Name="StartWindows" Content="{local:Localize Text=&#x27;Iniciar automáticamente con Windows, en la bandeja&#x27;}"/>
        <CheckBox x:Name="NotifyFinished" Content="{local:Localize Text=&#x27;Notificar las transferencias finalizadas&#x27;}" IsChecked="True"/>
        <TextBlock Text="{local:Localize Text=&#x27;Haz clic en el icono para recuperar la ventana. Para cerrar el programa y detener sus servicios, elige «Salir y detener servicios» en el menú de la bandeja. Windows controla la visualización de notificaciones.&#x27;}" Foreground="#687489" Margin="0,16,0,20"/>
        <WrapPanel><Button x:Name="SavePreferencesButton" Content="{local:Localize Text=&#x27;Guardar preferencias&#x27;}" Click="SavePreferencesClick" Background="#1A73E8" Foreground="White"/><Button Content="{local:Localize Text=&#x27;Minimizar ahora a la bandeja&#x27;}" Click="HideClick"/><Button Content="{local:Localize Text=&#x27;Salir y detener servicios&#x27;}" Click="ExitClick"/></WrapPanel>
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <TextBlock x:Name="Feedback" Grid.Row="3" Margin="0,12,0,0" Foreground="#174EA6"/>
  </Grid>
</UserControl>
