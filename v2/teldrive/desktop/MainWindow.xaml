<Window x:Class="Teldrive.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Teldrive.Desktop" Title="Teldrive Desktop v2" Icon="Assets/Teldrive.ico" ThemeMode="Light" Width="1250" Height="850" MinWidth="800" MinHeight="600" WindowStartupLocation="CenterScreen" Background="#F6F8FC" FontFamily="Segoe UI" FontSize="14">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="64"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
    <Border BorderBrush="#DFE5F0" BorderThickness="0,0,0,1" Padding="20,8"><Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Image Source="Assets/Teldrive.png" Width="38" Height="38" Margin="0,0,12,0"/><StackPanel><TextBlock Text="Teldrive" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{local:Localize Text=&#x27;Desktop · v2&#x27;}" Foreground="#687489" FontSize="11"/></StackPanel></StackPanel><WrapPanel Grid.Column="1" HorizontalAlignment="Right"><Button x:Name="DriveButton" Content="Teldrive" Click="DriveClick" ToolTip="{local:Localize Text=&#x27;Mostrar mi Drive&#x27;}" Margin="4,0"/><Button x:Name="StartButton" Content="{local:Localize Text=&#x27;Iniciar&#x27;}" Click="StartClick" Margin="4,0"/><Button x:Name="StopButton" Content="{local:Localize Text=&#x27;Detener&#x27;}" Click="StopClick" Margin="4,0" IsEnabled="False"/><Button Content="{local:Localize Text=&#x27;Configuración&#x27;}" Click="SetupClick" Margin="4,0"/><Button Content="{local:Localize Text=&#x27;Opciones adicionales de rclone&#x27;}" Click="AdvancedClick" Margin="4,0"/><Button Content="{local:Localize Text=&#x27;Actividad&#x27;}" Click="LogsClick" Margin="4,0"/></WrapPanel></Grid></Border>
    <Grid Grid.Row="1">
      <local:DriveWebView x:Name="Browser" Visibility="Collapsed"/>
      <local:RcloneAdvancedView x:Name="AdvancedView" Visibility="Collapsed"/>
      <ScrollViewer x:Name="SetupView" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="780" Margin="32">
        <TextBlock Text="{local:Localize Text=&#x27;Tu unidad, en tu equipo&#x27;}" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Text="{local:Localize Text=&#x27;Configura el servidor local y abre tu cuenta de Telegram desde esta ventana. Teldrive, rclone, PostgreSQL y multimedia están integrados.&#x27;}" Foreground="#687489" Margin="0,0,0,24"/>
        <Border Background="White" CornerRadius="16" Padding="24" Margin="0,0,0,20"><StackPanel>
          <TextBlock Text="{local:Localize Text=&#x27;Primer inicio&#x27;}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <TextBlock Text="{local:Localize Text=&#x27;Base de datos&#x27;}" FontWeight="SemiBold"/><CheckBox x:Name="LocalDatabase" Content="{local:Localize Text=&#x27;Usar PostgreSQL integrado en este equipo&#x27;}" IsChecked="True" Margin="0,12,0,12" MinHeight="44"/><TextBlock Text="URL de PostgreSQL externo (opcional)"/><TextBox x:Name="DatabaseUrl" ToolTip="{local:Localize Text=&#x27;postgres://usuario:contraseña@servidor/base&#x27;}"/>
          <TextBlock Text="{local:Localize Text=&#x27;Puerto local de la UI&#x27;}"/><TextBox x:Name="HttpPort" Text="8080"/>
          <TextBlock Text="{local:Localize Text=&#x27;Usuario permitido de Telegram&#x27;}"/><TextBox x:Name="AllowedUser" ToolTip="{local:Localize Text=&#x27;Tu nombre de usuario de Telegram, sin @&#x27;}"/>
          <TextBlock Text="{local:Localize Text=&#x27;Puedes iniciar sesión con el código QR o tu número de teléfono. Limitar el usuario evita que otras cuentas se registren en este servidor.&#x27;}" Foreground="#687489" Margin="0,0,0,16"/>
          <WrapPanel><Button Content="{local:Localize Text=&#x27;Guardar y abrir mi unidad&#x27;}" Click="ConfigureClick" Background="#1A73E8" Foreground="White"/><Button Content="{local:Localize Text=&#x27;Volver a mi unidad&#x27;}" Click="DriveClick"/></WrapPanel>
        </StackPanel></Border>
        <Border Background="White" CornerRadius="16" Padding="24" Margin="0,0,0,20"><StackPanel><TextBlock Text="{local:Localize Text=&#x27;Integraciones de Windows&#x27;}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="{local:Localize Text=&#x27;Rclone compatible con v2 y FFmpeg están incluidos. WinFsp permite montar Teldrive como una unidad; su controlador se prepara con este botón.&#x27;}" Foreground="#687489" Margin="0,0,0,16"/><WrapPanel><Button Content="{local:Localize Text=&#x27;Preparar WinFsp&#x27;}" Click="WinFspClick"/><Button Content="{local:Localize Text=&#x27;Preparar componentes de Microsoft&#x27;}" Click="RuntimeClick"/><Button Content="{local:Localize Text=&#x27;Abrir ajustes de rclone&#x27;}" Click="RcloneClick"/><Button Content="{local:Localize Text=&#x27;Carpeta de datos&#x27;}" Click="DataClick"/></WrapPanel></StackPanel></Border>
        <Border Background="White" CornerRadius="16" Padding="24"><StackPanel><TextBlock Text="{local:Localize Text=&#x27;Configuración avanzada&#x27;}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="{local:Localize Text=&#x27;Edita el TOML completo de v2. La configuración se valida antes de guardarla y se aplica al reiniciar el servidor.&#x27;}" Foreground="#687489"/><TextBox x:Name="ConfigEditor" AcceptsReturn="True" AcceptsTab="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" Height="250" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/><WrapPanel><Button Content="{local:Localize Text=&#x27;Guardar configuración avanzada&#x27;}" Click="SaveConfigClick"/><Button Content="{local:Localize Text=&#x27;Validar configuración&#x27;}" Click="ValidateClick"/></WrapPanel></StackPanel></Border>
      </StackPanel></ScrollViewer>
      <Grid x:Name="LogsView" Visibility="Collapsed" Margin="24" Background="#F6F8FC"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,16"><TextBlock Text="{local:Localize Text=&#x27;Actividad de los servicios&#x27;}" FontSize="24" FontWeight="SemiBold"/><Button Content="{local:Localize Text=&#x27;Volver&#x27;}" Click="DriveClick" HorizontalAlignment="Right"/></DockPanel><TextBox x:Name="Logs" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Background="#101923" Foreground="#DAE5F5"/></Grid>
    </Grid>
    <Border Grid.Row="2" Background="#EAF0FA" Padding="20,6"><TextBlock x:Name="Status" Text="{local:Localize Text=&#x27;Preparando componentes…&#x27;}" FontSize="12"/></Border>
  </Grid>
</Window>
